# =============================================================================
# Majestic Ally Wholesale Portal — environment variables
# Copy this file to ".env.local" for local dev, and set the same keys in
# Vercel's dashboard (Project → Settings → Environment Variables) for production.
# NEVER commit a filled-in .env file. Every value here is a secret.
# =============================================================================

# --- Core -------------------------------------------------------------------
# The full public URL of the site. Locally: http://localhost:3000
# In production: https://wholesale.majesticallyproducts.com (or your domain)
NEXTAUTH_URL="http://localhost:3000"

# A random 32+ char secret that signs login sessions.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- Database (Neon Postgres) ----------------------------------------------
# From Neon dashboard → Connection string (use the "pooled" connection).
# Leave blank locally to use the built-in zero-setup preview database (PGlite).
DATABASE_URL=""

# Set to 1 to force the local preview database even if DATABASE_URL is set.
# USE_PGLITE="1"

# --- Email (Resend) ---------------------------------------------------------
# From resend.com → API Keys. Used to send the retailer-interest notifications,
# order confirmations, and password-reset emails.
RESEND_API_KEY=""
# The "from" address emails are sent as. Must be a domain you've verified in
# Resend (e.g. no-reply@majesticallyproducts.com). This is also editable later
# in the admin Settings screen, which overrides this value.
EMAIL_FROM="Majestic Ally Wholesale <no-reply@majesticallyproducts.com>"

# --- Stripe (payments) ------------------------------------------------------
# From dashboard.stripe.com → Developers → API keys. Use TEST keys until ready.
STRIPE_SECRET_KEY=""
# From Stripe → Developers → Webhooks, after adding the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=""

# --- Shopify (catalog source) ----------------------------------------------
# Your store domain and an Admin API access token from a custom app.
# See README "Refresh from Shopify" for exact click-by-click steps.
SHOPIFY_STORE_DOMAIN="majesticallyproducts.myshopify.com"
SHOPIFY_ADMIN_TOKEN=""

# A secret that protects the nightly sync cron endpoint from public calls.
# Generate with: openssl rand -hex 16
CRON_SECRET=""

# --- First owner account (used once by the seed script) --------------------
# The seed script creates YOUR owner login from these. Change the password
# immediately after first login. Delete these after seeding if you like.
OWNER_EMAIL="info@majesticallyproducts.com"
OWNER_PASSWORD="change-me-on-first-login"
